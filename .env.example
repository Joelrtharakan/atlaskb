# AtlasKB local development environment.
# Copy to .env and fill in secrets. Run all commands from the repo root so this
# file is picked up (pydantic-settings reads ./.env relative to the CWD).

# Postgres credentials. docker-compose reads these to provision the DB; choose
# your own values (do NOT reuse these outside local dev).
POSTGRES_USER=atlaskb
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_DB=atlaskb

# Connection strings the API/worker use directly. Postgres/Redis are published by
# docker-compose on non-standard host ports to avoid clashing with other local
# stacks (see README). Keep the password here in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://atlaskb:CHANGE_ME_local_only@localhost:15432/atlaskb
REDIS_URL=redis://localhost:6380/0

# --- Connection pooling (Trust Layer T11.2) ---
# Per-process ceiling. With N horizontally-scaled API replicas, the real
# total is N * (DB_POOL_SIZE + DB_MAX_OVERFLOW) -- keep that comfortably
# under Postgres's own max_connections (100 by default), or put PgBouncer
# in front (see infra/docker/pgbouncer, opt-in via the `pgbouncer` compose
# profile) once replica count makes that arithmetic tight.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# REDIS_MAX_CONNECTIONS=50

# Auth — REQUIRED. Generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=CHANGE_ME_generate_a_long_random_string

# Where uploaded source files are stored (shared by API + worker).
# Where uploads are stored. A relative path is resolved against the repo root,
# so the API and worker agree no matter where each is launched from.
UPLOAD_DIR=var/uploads

# Embeddings: local sentence-transformers by default (no API key, runs offline).
# Options: local | openai | fake
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# OPENAI_API_KEY=            # only needed if EMBEDDING_BACKEND=openai

# --- LLM (generation for /chat) ---
# Provider: "ollama" (local, no quotas — default) or "openrouter" (hosted).
LLM_PROVIDER=ollama

# Ollama — local, OpenAI-compatible, bound to loopback. No API key, no quotas.
#   Install:  https://ollama.com/download   (macOS: brew install ollama)
#   Pull:     ollama pull qwen3:8b
#   Start:    ollama serve            (runs the daemon on 127.0.0.1:11434)
#   Test:     ollama run qwen3:8b     ("hello")
#   Verify:   curl http://127.0.0.1:11434/api/tags   (must list qwen3:8b)
# Keep Ollama bound to localhost — do NOT publish port 11434 publicly.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# OpenRouter (optional fallback; only used when LLM_PROVIDER=openrouter).
# Pick any current slug from https://openrouter.ai/models (must support
# structured/JSON output). Note: the free tier is capped at 50 requests/day.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.1

# Agent re-query budget. 1 = single retrieval pass, no second LLM assessment
# call (right for the 6-doc eval corpus). Default 3 for production.
# AGENT_MAX_ITERATIONS=1

# --- LLM generation concurrency (Trust Layer T11.1) ---
# Real ceiling is provider/hardware-specific: local Ollama on typical
# (non-dedicated-GPU) hardware serves ~1 generation well; raise this for a
# hosted provider or beefier local inference hardware. Requests beyond the
# limit queue (briefly) then get a clean 429 + Retry-After rather than
# piling up until they individually time out against the LLM itself.
LLM_CONCURRENCY_LIMIT=1
LLM_CONCURRENCY_QUEUE_TIMEOUT_SECONDS=20

# --- Connectors: Google Drive ---
# From Google Cloud Console: APIs & Services > Credentials > Create
# credentials > OAuth client ID > Web application. Add
# GOOGLE_REDIRECT_URI below as an authorized redirect URI on that client,
# and enable the "Google Drive API" for the project. Only needed if you
# connect a Google Drive source from Admin > Connectors.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/connectors/google/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CONNECTOR_TOKEN_KEY=

# --- Auth: SSO / OIDC ---
# Any standards-compliant OIDC provider works (Google Workspace, Okta, Azure
# AD, ...) via its discovery document at {issuer}/.well-known/openid-configuration.
# For Google specifically, you can reuse the same OAuth client registered
# above for the Drive connector — just add the "openid" and "email" scopes
# on it if they aren't already granted, and use issuer https://accounts.google.com.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback

LOG_LEVEL=INFO
