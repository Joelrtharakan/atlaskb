# AtlasKB local development environment.
# Copy to .env and fill in secrets. Run all commands from the repo root so this
# file is picked up (pydantic-settings reads ./.env relative to the CWD).

# Postgres credentials. docker-compose reads these to provision the DB; choose
# your own values (do NOT reuse these outside local dev).
POSTGRES_USER=atlaskb
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_DB=atlaskb

# Connection strings the API/worker use directly. Postgres/Redis are published by
# docker-compose on non-standard host ports to avoid clashing with other local
# stacks (see README). Keep the password here in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://atlaskb:CHANGE_ME_local_only@localhost:15432/atlaskb
REDIS_URL=redis://localhost:6380/0

# Auth — REQUIRED. Generate a long random value, e.g. `openssl rand -hex 32`.
JWT_SECRET=CHANGE_ME_generate_a_long_random_string

# Where uploaded source files are stored (shared by API + worker).
UPLOAD_DIR=./var/uploads

# Embeddings: local sentence-transformers by default (no API key, runs offline).
# Options: local | openai | fake
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# OPENAI_API_KEY=            # only needed if EMBEDDING_BACKEND=openai

# Generation via OpenRouter (OpenAI-compatible). Required for /chat.
# Pick any current slug from https://openrouter.ai/models. Paid example:
# openai/gpt-5.1. Zero-credit option (works without buying credits, must support
# structured output): nvidia/nemotron-nano-9b-v2:free or google/gemma-4-31b-it:free.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.1

LOG_LEVEL=INFO
