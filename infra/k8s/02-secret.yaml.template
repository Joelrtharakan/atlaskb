# Template only — copy to 02-secret.yaml, fill in real values, and do NOT
# commit the filled-in version (matches this repo's .env.example convention:
# no credential literals in tracked source). Apply with real values via
# `kubectl create secret generic atlaskb-secrets --namespace atlaskb
# --from-literal=DATABASE_URL=... --from-literal=JWT_SECRET=...` instead of
# applying this file directly, if you'd rather not have a plaintext Secret
# manifest on disk at all — either approach produces the same object.
apiVersion: v1
kind: Secret
metadata:
  name: atlaskb-secrets
  namespace: atlaskb
type: Opaque
stringData:
  DATABASE_URL: "postgresql+psycopg://USER:PASSWORD@HOST:5432/atlaskb"
  REDIS_URL: "redis://HOST:6379/0"
  JWT_SECRET: "CHANGE_ME_generate_a_long_random_string"
  OPENROUTER_API_KEY: ""
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
  CONNECTOR_TOKEN_KEY: ""
  OIDC_CLIENT_ID: ""
  OIDC_CLIENT_SECRET: ""
